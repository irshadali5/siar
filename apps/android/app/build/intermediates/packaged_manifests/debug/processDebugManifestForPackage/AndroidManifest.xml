<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.siar.messenger"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Iroh Internet/LAN (Phase 1) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
         mDNS local discovery needs a multicast lock — see
         siar-transport-wifi-direct's lib.rs doc comment on why Android
         silently drops multicast on a P2P interface without one held.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Wi-Fi Direct (next.md §15-17) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
         ACCESS_FINE_LOCATION is required by the platform for Wi-Fi Direct
         peer discovery and BLE scanning, not something this app wants
         for its own purposes — Android ties peer-scan results to
         location permission at the OS level; there is no way around
         declaring it if either transport is used.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
         Wi-Fi Aware / NAN (next.md §18-20), API 26+ — no separate
         ACCESS_WIFI_STATE declaration needed here: it's already
         declared once, above, for Wi-Fi Direct/mDNS use, and Android
         manifest permissions are declared once per app regardless of
         how many features rely on them (a duplicate declaration is a
         real AAPT-flagged warning, not just redundant-looking).
    -->
    <uses-feature
        android:name="android.hardware.wifi.aware"
        android:required="false" />

    <!-- BLE (next.md §22-26) and Bluetooth Classic (next.md §21) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!--
         API 31+ split Bluetooth permission into these three, each
         `neverForLocation` where the OS allows it — this app's BLE
         scanning is for peer discovery, never geolocation, and telling
         the OS that is what lets it skip also requiring
         ACCESS_FINE_LOCATION on API 31+ (unlike Wi-Fi Direct above,
         which has no such carve-out).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!--
         Emergency Mode (next.md Phase 6) may need to keep radios/relay
         work alive past what a foreground app alone survives (Doze,
         background execution limits) — declared here since the
         permission itself is manifest-level even though the actual
         foreground service (next.md §Phase 6's SOS mode) isn't built by
         this pass; see MainActivity.kt's own doc comment for what this
         app does and doesn't wire up yet.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <permission
        android:name="com.siar.messenger.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.siar.messenger.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.SiarMessenger"
        android:usesCleartextTraffic="false" >
        <activity
            android:name="com.siar.messenger.MainActivity"
            android:exported="true"
            android:launchMode="singleTop" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.siar.messenger.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>