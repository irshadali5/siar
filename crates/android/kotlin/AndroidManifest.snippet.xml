<!--
    Not a full manifest — dx generates the real one from Dioxus.toml.
    scripts/build-android.sh merges this fragment immediately before the
    generated </application> element. These are the additions dx has no
    way to know about on its own: the <service>
    declarations for CallForegroundService and RelayForegroundService
    (with the typed foregroundServiceType Android 14 requires for each),
    and the <receiver> for BootCompletedReceiver. Merge these into
    whatever <application> element dx's generated manifest produces.
-->
<service
    android:name="dev.irshad.siar.CallForegroundService"
    android:exported="false"
    android:foregroundServiceType="microphone|camera" />
<service
    android:name="dev.irshad.siar.RelayForegroundService"
    android:exported="false"
    android:foregroundServiceType="dataSync" />
<receiver
    android:name="dev.irshad.siar.BootCompletedReceiver"
    android:exported="true"
    android:enabled="true">
    <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
    </intent-filter>
</receiver>
